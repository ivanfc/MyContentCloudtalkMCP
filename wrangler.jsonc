/**
 * Configuración de Wrangler: https://developers.cloudflare.com/workers/wrangler/configuration/
 * Los secretos (GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, COOKIE_ENCRYPTION_KEY) NO van aquí:
 * se cargan con `wrangler secret put`. Las claves de CloudTalk de cada usuario viven cifradas en su grant OAuth.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mycontent-cloudtalk-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"migrations": [{ "new_sqlite_classes": ["CloudTalkMCP", "PlanLock", "UsageQuota"], "tag": "v1" }],
	"durable_objects": {
		"bindings": [
			{ "class_name": "CloudTalkMCP", "name": "MCP_OBJECT" },
			// Cerrojo global para que un plan no se aplique dos veces en paralelo (y cobre la cuota una sola vez).
			{ "class_name": "PlanLock", "name": "PLAN_LOCK" },
			// Cuota diaria por usuario y global (peticiones y contactos salientes).
			{ "class_name": "UsageQuota", "name": "USAGE_QUOTA" }
		]
	},
	"kv_namespaces": [
		// Estado del proveedor OAuth (clientes, grants cifrados con la clave de CloudTalk, tokens) y sesiones de registro.
		{ "binding": "OAUTH_KV", "id": "b13c54c66e4a419bad6dfe8761dfca9b" },
		// Planes (cifrados por usuario, TTL 24 h / 2 h) y auditoría (12 meses).
		{ "binding": "STATE_KV", "id": "c6b45876e05242e698c6a2b3995744c9" }
	],
	"vars": {
		// Abierto a cualquier cuenta de Google con email verificado: cada uno solo opera con SU clave de CloudTalk.
		// Para restringir: lista de emails separados por comas. Para cortar a alguien concreto: BLOCKED_EMAILS.
		"ALLOWED_EMAILS": "*",
		"BLOCKED_EMAILS": "",
		"CONTACT_EMAIL": "ivan@mycontent.agency",
		"PUBLIC_BASE_URL": "https://cloudtalk-mcp.mycontent.academy",
		// Operaciones del catálogo bloqueadas sin excepción (ids separados por comas o "tag:<Área>"). Vacío = ninguna.
		"HARD_BLOCKED_OPERATIONS": "",
		// SMS/WhatsApp: destinatarios y caracteres máximos por plan.
		"MAX_SMS_RECIPIENTS_PER_PLAN": "20",
		"MAX_SMS_CHARS": "1600",
		// Cuota diaria (UTC). calls = peticiones a CloudTalk; outreach = SMS + llamadas iniciadas + llamadas de VoiceAgent.
		"QUOTA_USER_CALLS": "5000",
		"QUOTA_USER_OUTREACH": "100",
		"QUOTA_GLOBAL_CALLS": "100000",
		"QUOTA_GLOBAL_OUTREACH": "2000"
	},
	"routes": [{ "pattern": "cloudtalk-mcp.mycontent.academy", "custom_domain": true }],
	"workers_dev": false,
	"observability": { "enabled": true, "redact_query_string": true },
	"dev": { "port": 8790 }
}
